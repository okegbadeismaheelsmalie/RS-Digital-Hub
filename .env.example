GEMINI_API_KEY=

# Supabase elevated service-role key for backend/admin tasks
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Administrator initial setup password (server-side only)
ADMIN_PASSWORD=
