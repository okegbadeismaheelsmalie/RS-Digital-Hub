# RS Digital Hub — Environment Variables Specification

# ==============================================================================
# BROWSER-SAFE / PUBLIC CLIENT VARIABLES
# Safe to expose to the frontend client for Supabase Auth & PostgREST queries
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# SERVER-ONLY PRIVILEGED SECRETS (NEVER EXPOSE TO BROWSER CLIENT)
